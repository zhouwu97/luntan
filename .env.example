APP_ENV=dev
HTTP_PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://luntan:luntan@127.0.0.1:5432/luntan?sslmode=disable
REDIS_URL=
OBJECT_STORAGE_UPLOAD_BASE_URL=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_SIGNING_SECRET=
# 仅开发/QA 可用：留空时不启用本地媒体兜底；生产环境必须使用对象存储。
MEDIA_STORAGE_DIR=
RATE_LIMIT_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=论坛
SMTP_TLS=true
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=
# 软件内更新发布清单。release.json 与 APK 必须位于同一发布目录中。
APP_RELEASE_MANIFEST_PATH=
# 公开 API 根地址；留空时客户端下载地址使用当前 API 域名的相对路径。
APP_RELEASE_PUBLIC_BASE_URL=
# Web 前端 Origin；服务端仅对该精确 Origin 使用 HttpOnly refresh Cookie。
WEB_ORIGIN=https://shengbeijiang.com
# 仅首次初始化空数据库时使用；邮箱必须对应已注册且已验证的账号。
BOOTSTRAP_SUPER_ADMIN_EMAIL=
