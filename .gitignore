# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# QA artifacts: local verification outputs (server binaries, source zips),
# never source; commit anything produced here only if it becomes a script.
.qa/

# Go 构建产物：部署时从源码构建，避免仓库中的二进制与源码版本漂移。
/bin/
/server/build/
