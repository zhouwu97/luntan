# Miscellaneous
*.class
*.log
*.pyc
*.swp
.env
.env.*
!.env.example
.DS_Store
.workbuddy/
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# QA artifacts: local verification outputs (server binaries, source zips),
# never source; commit anything produced here only if it becomes a script.
.qa/
artifacts/

# Go 构建产物：部署时从源码构建，避免仓库中的二进制与源码版本漂移。
/bin/
/server/build/

# Local runtime data, test scripts & credentials
.data/


# 源站内容导入产物：CSV 导入包与帖子配图体积大且可由脚本重新生成，
# 通过 scripts/import_placeholder_content.py 重新下载，不入库。
assets/imported-media/
assets/imports/
