APP_ENV=dev
HTTP_PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://luntan:luntan@127.0.0.1:5432/luntan?sslmode=disable
AUTH_CODE_HASH_SECRET=
ALLOW_DEV_AUTH_CODE=false
# 控制邮箱注册是否需要验证码；true（默认）需要验证码，false 启用临时免验证模式
AUTH_REGISTER_REQUIRE_EMAIL_CODE=true
REDIS_URL=
OBJECT_STORAGE_UPLOAD_BASE_URL=
# 仅用于明确公开的 ranking/imported 资源；禁止把 media/ 源图暴露在此公共前缀下。
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_SIGNING_SECRET=
# 媒体分发模式：开发可用 direct；生产必须显式选择 gateway 或 direct。
MEDIA_DELIVERY_MODE=direct
# gateway 模式下的 Nginx internal location 前缀，例如 /_protected_media；留空时由 Go 拉流。
MEDIA_INTERNAL_ACCEL_PREFIX=
# gateway 模式下 API 到对象存储的内网源站地址，禁止从公网直接访问。
STORAGE_INTERNAL_BASE_URL=
# 仅开发/QA 可用：留空时不启用本地媒体兜底；生产环境必须使用对象存储。
MEDIA_STORAGE_DIR=
RATE_LIMIT_ENABLED=false
TRUSTED_PROXY_CIDRS=
# 指标默认只接受 localhost；反向代理/Prometheus 使用时填写明确的内网 CIDR。
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=论坛
SMTP_TLS=true
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=
# 软件内更新发布清单。release.json 与 APK 必须位于同一发布目录中。
APP_RELEASE_MANIFEST_PATH=
# 公开 API 根地址；留空时客户端下载地址使用当前 API 域名的相对路径。
APP_RELEASE_PUBLIC_BASE_URL=
# 独立 APK 静态下载/CDN 根地址；配置后更新接口返回 /releases/<版本>/<文件>。
APP_RELEASE_DOWNLOAD_BASE_URL=
# Web 前端 Origin；服务端仅对该精确 Origin 使用 HttpOnly refresh Cookie。
WEB_ORIGIN=https://shengbeijiang.com
# 仅首次初始化空数据库时使用；邮箱必须对应已注册且已验证的账号。
BOOTSTRAP_SUPER_ADMIN_EMAIL=
